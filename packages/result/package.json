{
	"name": "@davidteju/result",
	"version": "0.1.1",
	"description": "The runtime half of @davidteju/dev-config's no-throw and no-cast rules: panic, unchecked, tagged errors and neverthrow helpers",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./zod": {
			"types": "./dist/zod.d.ts",
			"default": "./dist/zod.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p .",
		"lint": "eslint src tests",
		"format": "prettier --write .",
		"test": "vitest run",
		"verify": "npm run check && npm run lint && npm test",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"neverthrow": ">=8.0.0 <9.0.0",
		"zod": ">=4.0.0 <5.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DavidTeju/dev-config.git",
		"directory": "packages/result"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/eslint-plugin": "^1.6.28",
		"eslint": "^10.15.0",
		"neverthrow": "^8.2.0",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0",
		"zod": "^4.6.7"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	}
}
