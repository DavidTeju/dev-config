{
	"name": "@davidteju/dev-config",
	"version": "5.0.0",
	"description": "Shared ESLint, Oxfmt, TypeScript, and tooling configs for DavidTeju projects",
	"type": "module",
	"exports": {
		"./eslint": "./eslint/config.mjs",
		"./oxfmt/base": "./oxfmt/base.mjs",
		"./oxfmt/svelte": "./oxfmt/svelte.mjs",
		"./oxfmt/nextjs": "./oxfmt/nextjs.mjs",
		"./tsconfig/node": "./tsconfig/node.json",
		"./tsconfig/node-native": "./tsconfig/node-native.json",
		"./tsconfig/svelte": "./tsconfig/svelte.json",
		"./tsconfig/nextjs": "./tsconfig/nextjs.json",
		"./vitest/node": "./vitest/node.mjs",
		"./vitest/nextjs": "./vitest/nextjs.mjs",
		"./vitest/poll-floor": "./vitest/poll-floor.mjs",
		"./lint-staged/node": "./lint-staged/node.mjs",
		"./lint-staged/svelte": "./lint-staged/svelte.mjs",
		"./lint-staged/nextjs": "./lint-staged/nextjs.mjs",
		"./knip/base": "./knip/base.mjs",
		"./knip/svelte": "./knip/svelte.mjs",
		"./knip/nextjs": "./knip/nextjs.mjs"
	},
	"files": [
		"eslint",
		"oxfmt",
		"tsconfig",
		"vitest",
		"lint-staged",
		"knip"
	],
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"test": "node --test test/*.test.mjs && npm run verify --workspace @davidteju/result",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check ."
	},
	"dependencies": {
		"@eslint/js": "^10.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@typescript-eslint/type-utils": "^8.0.0",
		"@typescript-eslint/utils": "^8.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-import-resolver-typescript": "^4.0.0",
		"eslint-plugin-import-x": "^4.0.0",
		"eslint-plugin-n": "^17.0.0",
		"eslint-plugin-no-only-tests": "^3.0.0",
		"eslint-plugin-regexp": "^3.0.0",
		"eslint-plugin-sonarjs": "^4.0.0",
		"eslint-plugin-unused-imports": "^4.0.0",
		"globals": "^17.0.0",
		"knip": "^5.0.0",
		"typescript-eslint": "^8.0.0"
	},
	"peerDependencies": {
		"eslint": ">=9.0.0",
		"typescript": ">=5.0.0",
		"eslint-config-next": ">=14.0.0",
		"eslint-plugin-svelte": ">=3.0.0",
		"vitest": ">=1.0.0",
		"@vitest/eslint-plugin": ">=1.0.0",
		"@vitest/coverage-v8": ">=1.0.0",
		"neverthrow": ">=8.0.0 <9.0.0",
		"oxfmt": "0.79.0"
	},
	"peerDependenciesMeta": {
		"eslint-config-next": {
			"optional": true
		},
		"eslint-plugin-svelte": {
			"optional": true
		},
		"vitest": {
			"optional": true
		},
		"@vitest/eslint-plugin": {
			"optional": true
		},
		"@vitest/coverage-v8": {
			"optional": true
		},
		"neverthrow": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DavidTeju/dev-config.git"
	},
	"license": "MIT",
	"devDependencies": {
		"eslint-plugin-svelte": "3.23.1",
		"neverthrow": "8.2.0",
		"svelte": "5.57.3"
	}
}
